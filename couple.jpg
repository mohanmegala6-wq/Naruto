    margin: </span><span class="text-codex-syntax-literal">0</span><span>;
    padding: </span><span class="text-codex-syntax-literal">0</span><span>;
    box-sizing: </span><span class="text-codex-syntax-literal">border-box</span><span>;
}

</span><span class="text-codex-syntax-name">body</span><span> {
    font-family: </span><span class="text-codex-syntax-literal">Arial</span><span>, </span><span class="text-codex-syntax-literal">sans-serif</span><span>;
    overflow: </span><span class="text-codex-syntax-literal">hidden</span><span>;
}

.</span><span class="text-codex-syntax-literal">scene</span><span> {
    width: </span><span class="text-codex-syntax-literal">100</span><span class="text-codex-syntax-keyword">%</span><span>;
    height: </span><span class="text-codex-syntax-literal">100</span><span class="text-codex-syntax-keyword">vh</span><span>;

    display: </span><span class="text-codex-syntax-literal">flex</span><span>;
    justify-content: </span><span class="text-codex-syntax-literal">center</span><span>;
    align-items: </span><span class="text-codex-syntax-literal">center</span><span>;

    position: </span><span class="text-codex-syntax-literal">relative</span><span>;
    overflow: </span><span class="text-codex-syntax-literal">hidden</span><span>;

    background: </span><span class="text-codex-syntax-keyword">linear-gradient</span><span>(
        </span><span class="text-codex-syntax-literal">135</span><span class="text-codex-syntax-keyword">deg</span><span>,
        #ffc0cb,
        #ffb6e6,
        #d8b4fe
    );
}

.</span><span class="text-codex-syntax-literal">glow</span><span> {
    position: </span><span class="text-codex-syntax-literal">absolute</span><span>;

    width: </span><span class="text-codex-syntax-literal">300</span><span class="text-codex-syntax-keyword">px</span><span>;
    height: </span><span class="text-codex-syntax-literal">300</span><span class="text-codex-syntax-keyword">px</span><span>;

    background: #fff0f5;
    border-radius: </span><span class="text-codex-syntax-literal">50</span><span class="text-codex-syntax-keyword">%</span><span>;

    filter: </span><span class="text-codex-syntax-keyword">blur</span><span>(</span><span class="text-codex-syntax-literal">80</span><span class="text-codex-syntax-keyword">px</span><span>);

    animation: </span><span class="text-codex-syntax-literal">glowEffect</span><span> </span><span class="text-codex-syntax-literal">4</span><span class="text-codex-syntax-keyword">s</span><span> </span><span class="text-codex-syntax-literal">infinite</span><span> </span><span class="text-codex-syntax-literal">alternate</span><span>;
}

.</span><span class="text-codex-syntax-literal">content</span><span> {
    position: </span><span class="text-codex-syntax-literal">relative</span><span>;
    z-index: </span><span class="text-codex-syntax-literal">2</span><span>;

    text-align: </span><span class="text-codex-syntax-literal">center</span><span>;
    padding: </span><span class="text-codex-syntax-literal">20</span><span class="text-codex-syntax-keyword">px</span><span>;

    animation: </span><span class="text-codex-syntax-literal">appear</span><span> </span><span class="text-codex-syntax-literal">2</span><span class="text-codex-syntax-keyword">s</span><span> </span><span class="text-codex-syntax-literal">ease</span><span>;
}

.</span><span class="text-codex-syntax-literal">couple-image</span><span> {
    width: </span><span class="text-codex-syntax-keyword">min</span><span>(</span><span class="text-codex-syntax-literal">85</span><span class="text-codex-syntax-keyword">vw</span><span>, </span><span class="text-codex-syntax-literal">600</span><span class="text-codex-syntax-keyword">px</span><span>);
    max-height: </span><span class="text-codex-syntax-literal">60</span><span class="text-codex-syntax-keyword">vh</span><span>;

    object-fit: </span><span class="text-codex-syntax-literal">contain</span><span>;

    border-radius: </span><span class="text-codex-syntax-literal">20</span><span class="text-codex-syntax-keyword">px</span><span>;

    box-shadow: </span><span class="text-codex-syntax-literal">0</span><span> </span><span class="text-codex-syntax-literal">0</span><span> </span><span class="text-codex-syntax-literal">30</span><span class="text-codex-syntax-keyword">px</span><span> #ff69b4;
}

</span><span class="text-codex-syntax-name">h1</span><span> {
    color: #a4135c;
    margin-top: </span><span class="text-codex-syntax-literal">20</span><span class="text-codex-syntax-keyword">px</span><span>;
    font-size: </span><span class="text-codex-syntax-keyword">clamp</span><span>(</span><span class="text-codex-syntax-literal">28</span><span class="text-codex-syntax-keyword">px</span><span>, </span><span class="text-codex-syntax-literal">5</span><span class="text-codex-syntax-keyword">vw</span><span>, </span><span class="text-codex-syntax-literal">45</span><span class="text-codex-syntax-keyword">px</span><span>);
}

.</span><span class="text-codex-syntax-literal">message</span><span> {
    color: #7b2451;
    font-size: </span><span class="text-codex-syntax-literal">18</span><span class="text-codex-syntax-keyword">px</span><span>;
    margin-top: </span><span class="text-codex-syntax-literal">12</span><span class="text-codex-syntax-keyword">px</span><span>;
}

</span><span class="text-codex-syntax-name">button</span><span> {
    margin-top: </span><span class="text-codex-syntax-literal">20</span><span class="text-codex-syntax-keyword">px</span><span>;

    padding: </span><span class="text-codex-syntax-literal">12</span><span class="text-codex-syntax-keyword">px</span><span> </span><span class="text-codex-syntax-literal">25</span><span class="text-codex-syntax-keyword">px</span><span>;

    background: #ff4f91;
    color: </span><span class="text-codex-syntax-literal">white</span><span>;

    border: </span><span class="text-codex-syntax-literal">none</span><span>;
    border-radius: </span><span class="text-codex-syntax-literal">25</span><span class="text-codex-syntax-keyword">px</span><span>;

    font-size: </span><span class="text-codex-syntax-literal">17</span><span class="text-codex-syntax-keyword">px</span><span>;
    cursor: </span><span class="text-codex-syntax-literal">pointer</span><span>;

    transition: </span><span class="text-codex-syntax-literal">0.3</span><span class="text-codex-syntax-keyword">s</span><span>;
}

</span><span class="text-codex-syntax-name">button</span><span>:</span><span class="text-codex-syntax-literal">hover</span><span> {
    background: #e91e63;
    transform: </span><span class="text-codex-syntax-keyword">scale</span><span>(</span><span class="text-codex-syntax-literal">1.1</span><span>);
}

</span><span class="text-codex-syntax-keyword">#</span><span class="text-codex-syntax-name">loveMessage</span><span> {
    margin-top: </span><span class="text-codex-syntax-literal">15</span><span class="text-codex-syntax-keyword">px</span><span>;
    color: #a4135c;
    font-size: </span><span class="text-codex-syntax-literal">20</span><span class="text-codex-syntax-keyword">px</span><span>;
    font-weight: </span><span class="text-codex-syntax-literal">bold</span><span>;
}

.</span><span class="text-codex-syntax-literal">petal</span><span> {
    position: </span><span class="text-codex-syntax-literal">absolute</span><span>;
    top: </span><span class="text-codex-syntax-literal">-40</span><span class="text-codex-syntax-keyword">px</span><span>;

    pointer-events: </span><span class="text-codex-syntax-literal">none</span><span>;

    animation: </span><span class="text-codex-syntax-literal">falling</span><span> </span><span class="text-codex-syntax-literal">linear</span><span> </span><span class="text-codex-syntax-literal">forwards</span><span>;
}

.</span><span class="text-codex-syntax-literal">heart</span><span> {
    position: </span><span class="text-codex-syntax-literal">absolute</span><span>;
    bottom: </span><span class="text-codex-syntax-literal">-40</span><span class="text-codex-syntax-keyword">px</span><span>;

    pointer-events: </span><span class="text-codex-syntax-literal">none</span><span>;

    animation: </span><span class="text-codex-syntax-literal">floating</span><span> </span><span class="text-codex-syntax-literal">linear</span><span> </span><span class="text-codex-syntax-literal">forwards</span><span>;
}

</span><span class="text-codex-syntax-keyword">@keyframes</span><span> </span><span class="text-codex-syntax-name">falling</span><span> {
    </span><span class="text-codex-syntax-keyword">from</span><span> {
        transform: </span><span class="text-codex-syntax-keyword">translateY</span><span>(</span><span class="text-codex-syntax-literal">0</span><span>) </span><span class="text-codex-syntax-keyword">rotate</span><span>(</span><span class="text-codex-syntax-literal">0</span><span class="text-codex-syntax-keyword">deg</span><span>);
    }

    </span><span class="text-codex-syntax-keyword">to</span><span> {
        transform: </span><span class="text-codex-syntax-keyword">translateY</span><span>(</span><span class="text-codex-syntax-literal">110</span><span class="text-codex-syntax-keyword">vh</span><span>) </span><span class="text-codex-syntax-keyword">rotate</span><span>(</span><span class="text-codex-syntax-literal">720</span><span class="text-codex-syntax-keyword">deg</span><span>);
    }
}

</span><span class="text-codex-syntax-keyword">@keyframes</span><span> </span><span class="text-codex-syntax-name">floating</span><span> {
    </span><span class="text-codex-syntax-keyword">from</span><span> {
        transform: </span><span class="text-codex-syntax-keyword">translateY</span><span>(</span><span class="text-codex-syntax-literal">0</span><span>) </span><span class="text-codex-syntax-keyword">scale</span><span>(</span><span class="text-codex-syntax-literal">0.5</span><span>);
        opacity: </span><span class="text-codex-syntax-literal">0</span><span>;
    }

    </span><span class="text-codex-syntax-literal">20</span><span class="text-codex-syntax-keyword">%</span><span> {
        opacity: </span><span class="text-codex-syntax-literal">1</span><span>;
    }

    </span><span class="text-codex-syntax-keyword">to</span><span> {
        transform: </span><span class="text-codex-syntax-keyword">translateY</span><span>(</span><span class="text-codex-syntax-literal">-110</span><span class="text-codex-syntax-keyword">vh</span><span>) </span><span class="text-codex-syntax-keyword">scale</span><span>(</span><span class="text-codex-syntax-literal">1.5</span><span>);
        opacity: </span><span class="text-codex-syntax-literal">0</span><span>;
    }
}

</span><span class="text-codex-syntax-keyword">@keyframes</span><span> </span><span class="text-codex-syntax-name">glowEffect</span><span> {
    </span><span class="text-codex-syntax-keyword">from</span><span> {
        transform: </span><span class="text-codex-syntax-keyword">scale</span><span>(</span><span class="text-codex-syntax-literal">0.8</span><span>);
        opacity: </span><span class="text-codex-syntax-literal">0.5</span><span>;
    }

    </span><span class="text-codex-syntax-keyword">to</span><span> {
        transform: </span><span class="text-codex-syntax-keyword">scale</span><span>(</span><span class="text-codex-syntax-literal">1.3</span><span>);
        opacity: </span><span class="text-codex-syntax-literal">1</span><span>;
    }
}

</span><span class="text-codex-syntax-keyword">@keyframes</span><span> </span><span class="text-codex-syntax-name">appear</span><span> {
    </span><span class="text-codex-syntax-keyword">from</span><span> {
        opacity: </span><span class="text-codex-syntax-literal">0</span><span>;
        transform: </span><span class="text-codex-syntax-keyword">scale</span><span>(</span><span class="text-codex-syntax-literal">0.8</span><span>);
    }

    </span><span class="text-codex-syntax-keyword">to</span><span> {
        opacity: </span><span class="text-codex-syntax-literal">1</span><span>;
        transform: </span><span class="text-codex-syntax-keyword">scale</span><span>(</span><span class="text-codex-syntax-literal">1</span><span>);
    }
}</span></code></pre></div></div></div><button class="group/scroll-to-bottom cursor-interaction absolute z-30 flex h-8 w-8 translate-x-1/2 items-center justify-center rounded-full border border-default bg-surface bg-clip-padding text-secondary transition-opacity duration-basic ease-in-out end-1/2 print:hidden pointer-events-none opacity-0 bottom-4" aria-hidden="true" aria-label="Scroll to bottom" tabindex="-1" type="button"><svg aria-hidden="true" class="Icon-X4VkKC text-default" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-a37f3c54c7d1d31c.svg#arrow-down-lg-light-20" fill="currentColor"></use></svg></button></div></div></div><h2 class="Heading-Ro3lZr" dir="auto"><span>3️⃣ JavaScript Code — </span><span data-markdown-copy="inline-code" class="InlineCode-Cddi3Y InlineMarkdownIsolate-QWDV4W" dir="ltr">script.js</span></h2><p class="Paragraph-kKnbIo" dir="auto"><span>This makes the petals fall, hearts float, and button respond when clicked.</span></p><div class="CodeBlock-zu1QM3"><div data-code-block="true" data-markdown-copy="code-block" data-theme="dark" class="relative Root-iW7ipz w-full min-w-0 contain-inline-size overflow-clip rounded-(--radius-3xl-base) border border-subtle text-default CodeSurface-UAMd1A Surface-BCuIs1 dark @container" data-search-result-target=""><div data-markdown-copy="exclude" contenteditable="false" class="flex items-center font-sans text-sm select-none ActionBar-KWWAct min-h-12 gap-2 py-1.5 ps-4 pe-1.5 font-medium text-default md:ps-5 sticky z-10 StickyActionBar-RZfVQh"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-a37f3c54c7d1d31c.svg#code-light-20" fill="currentColor"></use></svg><div class="min-w-0 flex-1 truncate">JavaScript</div><div class="ms-auto flex items-center min-w-0 max-w-full"><div data-code-block-controls="true" role="presentation" class="flex items-center gap-px print:hidden flex-wrap justify-end"><span data-state="closed" class="contents"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full text-default not-disabled:not-aria-disabled:hover:bg-primary-ghost-hover data-[state=open]:bg-primary-ghost-hover border-transparent h-9 gap-1.5 border-0 px-2 py-0 text-sm leading-5 aspect-square shrink-0 items-center justify-center !px-0" aria-label="Enable word wrap" aria-pressed="false"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-a37f3c54c7d1d31c.svg#text-overflow-light-20" fill="currentColor"></use></svg></button></span><span data-state="closed" class="contents"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full text-default not-disabled:not-aria-disabled:hover:bg-primary-ghost-hover data-[state=open]:bg-primary-ghost-hover border-transparent h-9 gap-1.5 border-0 px-2 py-0 text-sm leading-5 aspect-square shrink-0 items-center justify-center !px-0" aria-label="Copy code"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-a37f3c54c7d1d31c.svg#square-on-square-light-20" fill="currentColor"></use></svg></button></span></div></div></div><div class="relative [container-type:inline-size]"><div class="InlineCodePane-EYx4bd w-full overflow-x-hidden"><div class="relative z-0 flex max-w-full Viewer-ALA646" dir="ltr"><div class="chatgpt-code-scrollport flex w-full items-stretch overscroll-x-contain Scrollport-kY3Nlm overflow-x-auto"><pre class="m-0 flex-1 cursor-text px-4 pb-3 font-mono text-size-code text-default md:px-5 ViewerContent-Cg8AgN pt-0 min-w-max whitespace-pre"><code><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">scene</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">document</span><span class="text-codex-syntax-keyword">.</span><span>querySelector(</span><span class="text-codex-syntax-string">".scene"</span><span>);
</span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">loveButton</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">document</span><span class="text-codex-syntax-keyword">.</span><span>getElementById(</span><span class="text-codex-syntax-string">"loveButton"</span><span>);
</span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">loveMessage</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">document</span><span class="text-codex-syntax-keyword">.</span><span>getElementById(</span><span class="text-codex-syntax-string">"loveMessage"</span><span>);

</span><span class="Comment-dh5VVn">// Create falling cherry blossom petals</span><span>
</span><span class="text-codex-syntax-keyword">function</span><span> </span><span class="text-codex-syntax-variable">createPetal</span><span>() {
    </span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">petal</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">document</span><span class="text-codex-syntax-keyword">.</span><span>createElement(</span><span class="text-codex-syntax-string">"div"</span><span>);

    </span><span class="text-codex-syntax-variable">petal</span><span class="text-codex-syntax-keyword">.</span><span>className </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-string">"petal"</span><span>;
    </span><span class="text-codex-syntax-variable">petal</span><span class="text-codex-syntax-keyword">.</span><span>textContent </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-string">"🌸"</span><span>;

    </span><span class="text-codex-syntax-variable">petal</span><span class="text-codex-syntax-keyword">.</span><span>style</span><span class="text-codex-syntax-keyword">.</span><span>left </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">Math</span><span class="text-codex-syntax-keyword">.</span><span>random() </span><span class="text-codex-syntax-keyword">*</span><span> </span><span class="text-codex-syntax-literal">100</span><span> </span><span class="text-codex-syntax-keyword">+</span><span> </span><span class="text-codex-syntax-string">"vw"</span><span>;

    </span><span class="text-codex-syntax-variable">petal</span><span class="text-codex-syntax-keyword">.</span><span>style</span><span class="text-codex-syntax-keyword">.</span><span>fontSize </span><span class="text-codex-syntax-keyword">=</span><span>
        (</span><span class="text-codex-syntax-literal">15</span><span> </span><span class="text-codex-syntax-keyword">+</span><span> </span><span class="text-codex-syntax-variable">Math</span><span class="text-codex-syntax-keyword">.</span><span>random() </span><span class="text-codex-syntax-keyword">*</span><span> </span><span class="text-codex-syntax-literal">20</span><span>) </span><span class="text-codex-syntax-keyword">+</span><span> </span><span class="text-codex-syntax-string">"px"</span><span>;

    </span><span class="text-codex-syntax-variable">petal</span><span class="text-codex-syntax-keyword">.</span><span>style</span><span class="text-codex-syntax-keyword">.</span><span>animationDuration </span><span class="text-codex-syntax-keyword">=</span><span>
        (</span><span class="text-codex-syntax-literal">4</span><span> </span><span class="text-codex-syntax-keyword">+</span><span> </span><span class="text-codex-syntax-variable">Math</span><span class="text-codex-syntax-keyword">.</span><span>random() </span><span class="text-codex-syntax-keyword">*</span><span> </span><span class="text-codex-syntax-literal">5</span><span>) </span><span class="text-codex-syntax-keyword">+</span><span> </span><span class="text-codex-syntax-string">"s"</span><span>;

    </span><span class="text-codex-syntax-variable">scene</span><span class="text-codex-syntax-keyword">.</span><span>appendChild(</span><span class="text-codex-syntax-variable">petal</span><span>);

    </span><span class="text-codex-syntax-variable">setTimeout</span><span>(() =&gt; {
        </span><span class="text-codex-syntax-variable">petal</span><span class="text-codex-syntax-keyword">.</span><span>remove();
    }, </span><span class="text-codex-syntax-literal">9000</span><span>);
}

</span><span class="Comment-dh5VVn">// Create floating hearts</span><span>
</span><span class="text-codex-syntax-keyword">function</span><span> </span><span class="text-codex-syntax-variable">createHeart</span><span>() {
    </span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">heart</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">document</span><span class="text-codex-syntax-keyword">.</span><span>createElement(</span><span class="text-codex-syntax-string">"div"</span><span>);

    </span><span class="text-codex-syntax-variable">heart</span><span class="text-codex-syntax-keyword">.</span><span>className </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-string">"heart"</span><span>;
    </span><span class="text-codex-syntax-variable">heart</span><span class="text-codex-syntax-keyword">.</span><span>textContent </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-string">"❤️"</span><span>;

    </span><span class="text-codex-syntax-variable">heart</span><span class="text-codex-syntax-keyword">.</span><span>style</span><span class="text-codex-syntax-keyword">.</span><span>left </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">Math</span><span class="text-codex-syntax-keyword">.</span><span>random() </span><span class="text-codex-syntax-keyword">*</span><span> </span><span class="text-codex-syntax-literal">100</span><span> </span><span class="text-codex-syntax-keyword">+</span><span> </span><span class="text-codex-syntax-string">"vw"</span><span>;

    </span><span class="text-codex-syntax-variable">heart</span><span class="text-codex-syntax-keyword">.</span><span>style</span><span class="text-codex-syntax-keyword">.</span><span>fontSize </span><span class="text-codex-syntax-keyword">=</span><span>
        (</span><span class="text-codex-syntax-literal">15</span><span> </span><span class="text-codex-syntax-keyword">+</span><span> </span><span class="text-codex-syntax-variable">Math</span><span class="text-codex-syntax-keyword">.</span><span>random() </span><span class="text-codex-syntax-keyword">*</span><span> </span><span class="text-codex-syntax-literal">20</span><span>) </span><span class="text-codex-syntax-keyword">+</span><span> </span><span class="text-codex-syntax-string">"px"</span><span>;

    </span><span class="text-codex-syntax-variable">heart</span><span class="text-codex-syntax-keyword">.</span><span>style</span><span class="text-codex-syntax-keyword">.</span><span>animationDuration </span><span class="text-codex-syntax-keyword">=</span><span>
        (</span><span class="text-codex-syntax-literal">4</span><span> </span><span class="text-codex-syntax-keyword">+</span><span> </span><span class="text-codex-syntax-variable">Math</span><span class="text-codex-syntax-keyword">.</span><span>random() </span><span class="text-codex-syntax-keyword">*</span><span> </span><span class="text-codex-syntax-literal">3</span><span>) </span><span class="text-codex-syntax-keyword">+</span><span> </span><span class="text-codex-syntax-string">"s"</span><span>;

    </span><span class="text-codex-syntax-variable">scene</span><span class="text-codex-syntax-keyword">.</span><span>appendChild(</span><span class="text-codex-syntax-variable">heart</span><span>);

    </span><span class="text-codex-syntax-variable">setTimeout</span><span>(() =&gt; {
        </span><span class="text-codex-syntax-variable">heart</span><span class="text-codex-syntax-keyword">.</span><span>remove();
    }, </span><span class="text-codex-syntax-literal">8000</span><span>);
}

</span><span class="Comment-dh5VVn">// Show love when the button is clicked</span><span>
</span><span class="text-codex-syntax-variable">loveButton</span><span class="text-codex-syntax-keyword">.</span><span>addEventListener(</span><span class="text-codex-syntax-string">"click"</span><span>, </span><span class="text-codex-syntax-keyword">function</span><span> () {

    </span><span class="text-codex-syntax-variable">loveMessage</span><span class="text-codex-syntax-keyword">.</span><span>textContent </span><span class="text-codex-syntax-keyword">=</span><span>
        </span><span class="text-codex-syntax-string">"Naruto ❤️ Hinata — Forever Together! 💕"</span><span>;

    </span><span class="Comment-dh5VVn">// Create a burst of hearts</span><span>
    </span><span class="text-codex-syntax-keyword">for</span><span> (</span><span class="text-codex-syntax-keyword">let</span><span> </span><span class="text-codex-syntax-variable">i</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-literal">0</span><span>; </span><span class="text-codex-syntax-variable">i</span><span> </span><span class="text-codex-syntax-keyword">&lt;</span><span> </span><span class="text-codex-syntax-literal">20</span><span>; </span><span class="text-codex-syntax-variable">i</span><span class="text-codex-syntax-keyword">++</span><span>) {
        </span><span class="text-codex-syntax-variable">setTimeout</span><span>(</span><span class="text-codex-syntax-variable">createHeart</span><span>, </span><span class="text-codex-syntax-variable">i</span><span> </span><span class="text-codex-syntax-keyword">*</span><span> </span><span class="text-codex-syntax-literal">100</span><span>);
    }

});

</span><span class="Comment-dh5VVn">// Start the animation</span><span>
</span><span class="text-codex-syntax-variable">setInterval</span><span>(</span><span class="text-codex-syntax-variable">createPetal</span><span>, </span><span class="text-codex-syntax-literal">300</span><span>);

</span><span class="text-codex-syntax-variable">setInterval</span><span>(</span><span class="text-codex-syntax-variable">createHeart</span><span>, </span><span class="text-codex-syntax-literal">1000</span><span>);</span></code></pre></div></div></div><button class="group/scroll-to-bottom cursor-interaction absolute z-30 flex h-8 w-8 translate-x-1/2 items-center justify-center rounded-full border border-default bg-surface bg-clip-padding text-secondary transition-opacity duration-basic ease-in-out end-1/2 print:hidden pointer-events-none opacity-0 bottom-4" aria-hidden="true" aria-label="Scroll to bottom" tabindex="-1" type="button"><svg aria-hidden="true" class="Icon-X4VkKC text-default" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-a37f3c54c7d1d31c.svg#arrow-down-lg-light-20" fill="currentColor"></use></svg></button></div></div></div><hr class="HorizontalRule-ByOEk_"><h2 class="Heading-Ro3lZr" dir="auto"><span>🎬 Step 4: Run your animation</span></h2><p class="Paragraph-kKnbIo" dir="auto"><span>Follow these steps carefully, Maggie. ❤️</span></p><ol class="List-kOVW5V OrderedList-XsMUSX" dir="auto" start="1"><li class="ListItem-ncLgmg"><span>Open </span><strong class="font-semibold"><span>Notepad</span></strong><span>.</span></li><li class="ListItem-ncLgmg"><span>Copy the HTML code and save it as </span><span data-markdown-copy="inline-code" class="InlineCode-Cddi3Y InlineMarkdownIsolate-QWDV4W" dir="ltr">index.html</span><span>.</span></li><li class="ListItem-ncLgmg"><span>Create another file in Notepad, copy the CSS code, and save it as </span><span data-markdown-copy="inline-code" class="InlineCode-Cddi3Y InlineMarkdownIsolate-QWDV4W" dir="ltr">style.css</span><span>.</span></li><li class="ListItem-ncLgmg"><span>Create the third file, copy the JavaScript code, and save it as </span><span data-markdown-copy="inline-code" class="InlineCode-Cddi3Y InlineMarkdownIsolate-QWDV4W" dir="ltr">script.js</span><span>.</span></li><li class="ListItem-ncLgmg"><span>Save all three files inside the same </span><span data-markdown-copy="inline-code" class="InlineCode-Cddi3Y InlineMarkdownIsolate-QWDV4W" dir="ltr">NarutoHinata</span><span> folder.</span></li><li class="ListItem-ncLgmg"><span>Add the Naruto and Hinata picture and name it </span><span data-markdown-copy="inline-code" class="InlineCode-Cddi3Y InlineMarkdownIsolate-QWDV4W" dir="ltr">couple.jpg</span><span>.</span></li><li class="ListItem-ncLgmg"><span>Double-click </span><span data-markdown-copy="inline-code" class="InlineCode-Cddi3Y InlineMarkdownIsolate-QWDV4W" dir="ltr">index.html</span><span> to open it in Chrome.</span></li></ol><p class="Paragraph-kKnbIo" dir="auto"><strong class="font-semibold"><span>Important:</span></strong><span> In Notepad's Save As window, choose </span><strong class="font-semibold"><span>Save as type: All Files</span></strong><span> so that your files don't accidentally become </span><span data-markdown-copy="inline-code" class="InlineCode-Cddi3Y InlineMarkdownIsolate-QWDV4W" dir="ltr">index.html.txt</span><span>, </span><span data-markdown-copy="inline-code" class="InlineCode-Cddi3Y InlineMarkdownIsolate-QWDV4W" dir="ltr">style.css.txt</span><span>, or </span><span data-markdown-copy="inline-code" class="InlineCode-Cddi3Y InlineMarkdownIsolate-QWDV4W" dir="ltr">script.js.txt</span><span>.</span></p><h3 class="Heading-Ro3lZr" dir="auto"><span>❤️ What will your project do?</span></h3><div class="group/app-widget pointer-coarse:pt-11 [@media(hover:none)]:pt-11 TableContainer-UfIOz_" data-markdown-table="true" data-wide-block="" tabindex="-1"><div class="TableScroller-ZhMTLB" data-horizontal-scroll="true"><div class="TableWrapper-i1mUIE"><table class="Table-LqdUhs" dir="auto"><thead><tr class="TableRow-ENsaGm"><th class="TableHeaderCell-esYSpn SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>Feature</span></th><th class="TableHeaderCell-esYSpn SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>Result</span></th></tr></thead><tbody class="TableBody-A5sMNL"><tr class="TableRow-ENsaGm"><td class="TableCell-WcsygL SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>Naruto and Hinata image</span></td><td class="TableCell-WcsygL SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>Displays the couple</span></td></tr><tr class="TableRow-ENsaGm"><td class="TableCell-WcsygL SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>Falling cherry blossoms</span></td><td class="TableCell-WcsygL SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>🌸 Animated petals</span></td></tr><tr class="TableRow-ENsaGm"><td class="TableCell-WcsygL SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>Floating hearts</span></td><td class="TableCell-WcsygL SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>❤️ Romantic effects</span></td></tr><tr class="TableRow-ENsaGm"><td class="TableCell-WcsygL SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>Glowing background</span></td><td class="TableCell-WcsygL SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>✨ Soft animation</span></td></tr><tr class="TableRow-ENsaGm"><td class="TableCell-WcsygL SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>Send Love button</span></td><td class="TableCell-WcsygL SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>💗 Displays a romantic message</span></td></tr><tr class="TableRow-ENsaGm"><td class="TableCell-WcsygL SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>HTML</span></td><td class="TableCell-WcsygL SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>Creates the webpage</span></td></tr><tr class="TableRow-ENsaGm"><td class="TableCell-WcsygL SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>CSS</span></td><td class="TableCell-WcsygL SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>Controls the design and animations</span></td></tr><tr class="TableRow-ENsaGm"><td class="TableCell-WcsygL SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>JavaScript</span></td><td class="TableCell-WcsygL SingleChildTableCell-Sv7jTC" dir="auto" data-col-size="sm"><span>Controls the interactive effects</span></td></tr></tbody></table></div></div><div class="absolute end-0 top-0 z-50 flex w-fit select-none items-center gap-1 rounded-full bg-surface p-0.5 text-tertiary pointer-events-none opacity-0 group-hover/app-widget:pointer-events-auto group-hover/app-widget:opacity-100 focus-within:pointer-events-auto focus-within:opacity-100 data-[visible=true]:pointer-events-auto data-[visible=true]:opacity-100 has-data-[state=open]:pointer-events-auto has-data-[state=open]:opacity-100 pointer-coarse:pointer-events-auto pointer-coarse:opacity-100 [@media(hover:none)]:pointer-events-auto [@media(hover:none)]:opacity-100" data-block-actions="true" data-markdown-copy="exclude"><span data-state="closed" class="contents"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full text-tertiary not-disabled:not-aria-disabled:hover:bg-primary-ghost-hover not-disabled:not-aria-disabled:hover:text-default data-[state=open]:bg-primary-ghost-hover border-transparent size-9 justify-center border-0 p-0" aria-label="Copy table"><span class="CompactSource-d7ZD01" aria-hidden="true"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="16" viewBox="0 0 16 16" width="16" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-a37f3c54c7d1d31c.svg#square-on-square-light-16" fill="currentColor"></use></svg></span><span class="LeadingSource-d79mNZ" aria-hidden="true"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-a37f3c54c7d1d31c.svg#square-on-square-light-20" fill="currentColor"></use></svg></span></button></span><span data-state="closed" class="contents"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full text-tertiary not-disabled:not-aria-disabled:hover:bg-primary-ghost-hover not-disabled:not-aria-disabled:hover:text-default data-[state=open]:bg-primary-ghost-hover border-transparent size-9 justify-center border-0 p-0" aria-label="Expand table" aria-expanded="false" aria-haspopup="dialog"><span class="CompactSource-d7ZD01" aria-hidden="true"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="16" viewBox="0 0 16 16" width="16" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-a37f3c54c7d1d31c.svg#arrow-up-right-arrow-down-left-md-light-16" fill="currentColor"></use></svg></span><span class="LeadingSource-d79mNZ" aria-hidden="true"><svg aria-hidden="true" class="Icon-X4VkKC" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-a37f3c54c7d1d31c.svg#arrow-up-right-arrow-down-left-sm-light-20" fill="currentColor"></use></svg></span></button></span></div></div><p class="Paragraph-kKnbIo" dir="auto"><strong class="font-semibold"><span>One important thing:</span></strong><span> This project creates a moving animation in your browser, not an MP4 video file. You can record the animation using your screen recorder to make a video.</span></p><p class="Paragraph-kKnbIo" dir="auto"><span>Maggie, once this works, we can take the next step and create a </span><strong c